// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CRN {
  crn_id         Int            @id
  class_name     String
  class_seats    Int
  waitlist_seats Int
  UserTracking   UserTracking[]
}

model UserTracking {
  user_tracking_id Int      @id @default(autoincrement())
  User             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String?
  CRN              CRN?     @relation(fields: [crnId], references: [crn_id], onDelete: Cascade)
  crnId            Int
  class_alias      String
  guild_id         String
  guild_name       String
  created_at       DateTime @default(now())
}

model User {
  id                 String         @id
  name               String
  crns               UserTracking[]
  total_tracked_crns Int
}
